# AuraStudio 服务端环境变量（复制为 .env.local 后填写）
# 密钥只放服务端，切勿写入 VITE_ 前缀，也勿提交到 Git

# 生成模式：demo | fal | vibradraft
AI_PROVIDER=demo

# fal.ai API Key — https://fal.ai/dashboard/keys
FAL_KEY=

# VibraDraft MCP（周大福 AIGC）
# 注意：请使用 https（该主机 80 端口通常不可用）
VIBRADRAFT_MCP_URL=https://aigc.chowtaifook.com/mcp
VIBRADRAFT_MCP_TOKEN=
# 默认生图模型：Azure GPT-Image-2
VIBRADRAFT_MODEL_ID=gpt-image-2.0

# 服务端口（Vite 会把 /api 代理到这里）
PORT=8787

# 登录与用户管理
# SQLite 数据库路径；默认保存在 .storage/aurastudio.db
SQLITE_PATH=.storage/aurastudio.db
# 登录会话有效期（天）
SESSION_TTL_DAYS=14
# 仅在首次启动、数据库尚无用户时使用
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
# 配置 HTTPS 后设为 true；本地开发或仅 HTTP 时保持 false
AUTH_COOKIE_SECURE=false
